{
  "name": "stockmora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:media": "node --test tests/media.test.mjs tests/media-migration.test.mjs",
    "test:admin-products": "node --test tests/admin-products.test.mjs",
    "test:csv-images": "node --test tests/csv-images.test.mjs",
    "test:product-gallery": "node --test tests/product-gallery.test.mjs",
    "test:media-management-migration": "node --test tests/media-management-migration.test.mjs",
    "test:media-management": "node --test tests/media-management.test.mjs",
    "db:media-status": "node scripts/check-media-migration.mjs",
    "db:media-migrate": "node scripts/migrate-media.mjs",
    "db:media-management": "node scripts/migrate-media-management.mjs",
    "db:media-runtime": "node scripts/check-media-runtime.mjs",
    "db:auth-email": "node scripts/migrate-auth-email.mjs",
    "test:auth-email-migration": "node --test tests/auth-email-migration.test.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "auth:migrate": "npx auth@latest migrate --config ./src/lib/auth.ts --yes",
    "db:auth-email-runtime": "node scripts/check-auth-email-runtime.mjs",
    "test:auth-email": "node --test tests/account-email.test.mjs tests/auth-recovery.test.mjs tests/auth-email-migration.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
